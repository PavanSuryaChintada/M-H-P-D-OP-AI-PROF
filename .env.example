# Copy to .env and fill in. Never commit .env — see .gitignore.

# Supabase Postgres. New Supabase projects only expose the direct
# "db.[ref].supabase.co" host over IPv6 — most dev/CI networks are IPv4-only,
# so use the Supavisor pooler instead (Project Settings → Database →
# Connection string):
#   Session pooler (port 5432) — for DATABASE_URL (drizzle-kit migrations;
#     needs full session semantics and superuser-level DDL privileges).
#   Transaction pooler (port 6543) — for DATABASE_URL_POOLED (app/worker
#     runtime, connects as app_user — see lib/db/rls.sql). The app's
#     postgres.js client is configured with prepare:false for this, since
#     transaction-mode pooling doesn't support server-side prepared
#     statements.
# Pooler usernames are "<role>.[project-ref]", not just the role name.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL_POOLED=postgresql://app_user.[PROJECT_REF]:[APP_USER_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase project — used for Supabase Auth (doc 02). SUPABASE_URL/ANON_KEY
# are read server-side (route handlers, middleware); the NEXT_PUBLIC_ copies
# are the same values exposed to the browser client (lib/supabase/client.ts)
# — safe to expose, the publishable/anon key is designed for that.
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT_REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role (or new-style "secret") key — Project Settings → API. Used
# only by scripts/seed-demo-users.ts to create pre-confirmed demo accounts
# via the Admin API; never imported by application/route-handler code.
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — genuinely independent models for escalation consensus (doc 13).
# Either set the two vendor keys directly below, OR set OPENROUTER_API_KEY
# instead — OpenRouter is a single OpenAI-compatible endpoint that can reach
# both vendors' models (lib/ai/providers/select-provider.ts routes "primary"
# and "secondary" to two different underlying models through it). If both are
# set, OPENROUTER_API_KEY wins. If neither is set, every AI call uses the
# deterministic mock provider — this is a real safety feature, not a missing
# setup step; see docs/known-limitations.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Optional — only if you want different underlying models than the defaults
# (anthropic/claude-sonnet-5 and openai/gpt-4o-mini).
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_SECONDARY_MODEL=
# Optional — daily per-hospital AI spend ceiling in USD (default 5). Once a
# hospital's recorded ai_usage for today reaches this, it falls back to the
# mock provider for the rest of the day (doc 23 R7's cost guard).
AI_DAILY_BUDGET_USD=

# Worker identity, used to tag outreach_tasks.claimed_by (docs 06/07).
WORKER_ID=worker-local-1
