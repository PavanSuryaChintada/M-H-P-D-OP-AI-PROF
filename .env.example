# Copy to .env and fill in. Never commit .env — see .gitignore.

# Supabase Postgres. New Supabase projects only expose the direct
# "db.[ref].supabase.co" host over IPv6 — most dev/CI networks are IPv4-only,
# so use the Supavisor pooler instead (Project Settings → Database →
# Connection string):
#   Session pooler (port 5432) — for DATABASE_URL (drizzle-kit migrations;
#     needs full session semantics and superuser-level DDL privileges).
#   Transaction pooler (port 6543) — for DATABASE_URL_POOLED (app/worker
#     runtime, connects as app_user — see lib/db/rls.sql). The app's
#     postgres.js client is configured with prepare:false for this, since
#     transaction-mode pooling doesn't support server-side prepared
#     statements.
# Pooler usernames are "<role>.[project-ref]", not just the role name.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL_POOLED=postgresql://app_user.[PROJECT_REF]:[APP_USER_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase project — used for Supabase Auth (doc 02).
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers — genuinely independent models for escalation consensus (doc 13).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Worker identity, used to tag outreach_tasks.claimed_by (docs 06/07).
WORKER_ID=worker-local-1
